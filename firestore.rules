rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Primera fase: acceso exclusivo a la cuenta administradora de Momentum.
    // La separación por concesionario se añadirá al implantar el modelo multi-tenant.
    function isMomentumAdmin() {
      return request.auth != null
        && request.auth.token.email == "a.henares@momentummotor.es";
    }

    match /{document=**} {
      allow read, write: if isMomentumAdmin();
    }
  }
}
